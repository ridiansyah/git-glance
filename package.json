{
  "name": "git-glance",
  "displayName": "Git Glance",
  "description": "A modern, ultra-lightweight, and delightful inline Git blame extension for Visual Studio Code",
  "version": "1.2.0",
  "publisher": "ridiansyah",
  "author": {
    "name": "Wahyu Ridiansyah",
    "url": "https://github.com/ridiansyah"
  },
  "icon": "images/icon.png",
  "homepage": "https://github.com/ridiansyah/git-glance#readme",
  "bugs": {
    "url": "https://github.com/ridiansyah/git-glance/issues"
  },
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#181825",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git Glance executes local git commands which are disabled in Restricted Mode for security."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Git Glance requires a local git repository."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ridiansyah/git-glance"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "gitlens",
    "inline blame",
    "author",
    "git-glance",
    "gitblame",
    "git blame",
    "gitlens alternative",
    "git glance"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitGlance.toggle",
        "title": "Git Glance: Toggle Inline Blame",
        "icon": "$(eye)"
      },
      {
        "command": "gitGlance.toggleAvatar",
        "title": "Git Glance: Toggle Avatar",
        "icon": "$(account)"
      },
      {
        "command": "gitGlance.copyHash",
        "title": "Git Glance: Copy Commit Hash",
        "icon": "$(clippy)"
      },
      {
        "command": "gitGlance.showCommitDetails",
        "title": "Git Glance: Show Commit Details",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitGlance.openOnRemote",
        "title": "Git Glance: Open Commit on Remote (GitHub/GitLab)",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitGlance.toggle"
        },
        {
          "command": "gitGlance.toggleAvatar"
        },
        {
          "command": "gitGlance.copyHash",
          "when": "editorTextFocus && resourceScheme == file"
        },
        {
          "command": "gitGlance.showCommitDetails",
          "when": "editorTextFocus && resourceScheme == file"
        },
        {
          "command": "gitGlance.openOnRemote",
          "when": "editorTextFocus && resourceScheme == file"
        }
      ]
    },
    "colors": [
      {
        "id": "gitGlance.inlineColor",
        "description": "Color for the inline blame text.",
        "defaults": {
          "dark": "#88888888",
          "light": "#66666688",
          "highContrast": "#ffffff99"
        }
      }
    ],
    "configuration": {
      "title": "Git Glance",
      "properties": {
        "gitGlance.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable inline blame annotations."
        },
        "gitGlance.preset": {
          "type": "string",
          "enum": [
            "default",
            "minimalist",
            "playful",
            "terminal",
            "github",
            "breadcrumb",
            "bento",
            "comment",
            "custom"
          ],
          "enumDescriptions": [
            "Default: (avatar) Author, 3 days ago: Message",
            "Minimalist: · Author, 3d ago — Message",
            "Playful: 👀 Author, 3 days ago • 🚀 Message",
            "Terminal: // git:author @ hash (3d) \"Message\"",
            "GitHub: @author, 3d ago: Message",
            "Breadcrumb: › Author › 3d ago › Message",
            "Bento: ⚡ Author │ ⏱️ 3d ago │ 💬 Message",
            "Comment: /* by Author, 3d ago: Message */",
            "Custom: Freely customized via gitGlance.format"
          ],
          "default": "default",
          "description": "Choose a preset style, or select 'custom' to freely design your own format."
        },
        "gitGlance.showAvatar": {
          "type": "boolean",
          "default": true,
          "description": "Show profile picture / avatar next to inline annotation. When disabled, only text is shown."
        },
        "gitGlance.avatarSource": {
          "type": "string",
          "enum": [
            "remote",
            "initials"
          ],
          "enumDescriptions": [
            "Download author photos from GitHub and Gravatar (sends the email hash or commit SHA to those services). Initials are shown until a photo is found.",
            "Only show locally generated initials. Nothing is sent over the network."
          ],
          "default": "remote",
          "description": "Where avatar images come from."
        },
        "gitGlance.maxMessageLength": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Shorten the commit message in the inline annotation to this many characters, ending with '…'. Set to 0 for no limit."
        },
        "gitGlance.remote": {
          "type": "string",
          "default": "",
          "description": "Name of the git remote used for 'Open in Browser' links. Leave empty to use 'origin', or the first remote when there is no 'origin'."
        },
        "gitGlance.useIgnoreRevsFile": {
          "type": "boolean",
          "default": true,
          "description": "Skip commits listed in the repository's .git-blame-ignore-revs file (e.g. bulk formatting commits) and show the commit before them."
        },
        "gitGlance.prefix": {
          "type": "string",
          "default": "👀 ",
          "description": "Prefix emoji or text token (available as ${prefix} in custom format)."
        },
        "gitGlance.format": {
          "type": "string",
          "default": "${author}, ${time}: ${message}",
          "description": "Custom inline template (when preset is 'custom'). Tokens: ${author}, ${time}, ${date}, ${isoDate}, ${message}, ${hash}, ${shortHash}, ${fullHash}, ${email}, ${authorEmail}, ${prefix}."
        },
        "gitGlance.uncommittedFormat": {
          "type": "string",
          "default": "${author}, ${time}: ${message}",
          "description": "Custom uncommitted line template (when preset is 'custom'). Tokens: ${author}, ${message}, ${prefix}, ${time}, ${date}, ${isoDate}."
        },
        "gitGlance.dateStyle": {
          "type": "string",
          "enum": [
            "relative",
            "absolute",
            "short"
          ],
          "default": "relative",
          "description": "Style for the commit date (e.g. '3 days ago', '2026-09-28', 'Sep 28')."
        },
        "gitGlance.hoverDateFormat": {
          "type": "string",
          "default": "DD/MM/YYYY HH:mm",
          "description": "Format for the exact commit date shown in hover tooltip. Tokens: YYYY, YY, MMMM, MMM, MM, M, DD, D, dddd, ddd, HH, H, hh, h, mm, m, ss, s, A, a, and [escaped text]."
        },
        "gitGlance.delay": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 2000,
          "description": "Debounce delay in milliseconds before fetching git blame after moving cursor."
        },
        "gitGlance.showHover": {
          "type": "boolean",
          "default": true,
          "description": "Show rich commit information tooltip when hovering over the inline annotation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --watch",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "package:vsix": "vsce package --no-git-tag-version",
    "test": "esbuild ./src/test/unit.test.ts ./src/test/git-service.test.ts --bundle --outdir=dist/test --platform=node --target=node18 && node --test dist/test/unit.test.js dist/test/git-service.test.js",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}
